# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTHOR_NAME="Ahmed OUN"

# Database (PostgreSQL with Prisma) - Optional
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahmed_portfolio?schema=public"

# Cookie Signing Secret
SIGNING_SECRET="ahmed-oun-portfolio-development-signing-key-32chars"

# Contentful CMS (Optional - falls back to built-in Ahmed OUN data)
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=""
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""

# OpenAI API Key (Optional for ManuPilot AI chatbot)
OPENAI_API_KEY=""

# EmailJS (Optional for Contact Form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# Google reCAPTCHA (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
